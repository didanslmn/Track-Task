# Salin file ini menjadi .env dan isi sesuai environment Anda.
# JANGAN commit file .env.

# ----- App / Environment -----
# development | staging | production
ENV=development

# ----- Server -----
SERVER_HOST=localhost
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s

# ----- Database (PostgreSQL) -----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=teamtask
DB_USER=postgres
DB_PASSWORD=changeme
DB_SSLMODE=disable
DB_CHANNEL_BINDING=disable

# ----- Auth / JWT -----
# JWT_SECRET WAJIB diisi dengan nilai acak panjang di production.
JWT_SECRET=replace-with-long-random-secret
JWT_ACCESS_TTL=15m
JWT_ISSUER=teamtask-api